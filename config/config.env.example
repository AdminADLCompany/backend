# Copy this file to config/config.env and fill in real values.
# Never commit config/config.env.

# ---------- Server ----------
# "production" hides stack traces in API error responses.
NODE_ENV=production
# 127.0.0.1 when Caddy terminates HTTPS in front of Node (recommended).
# 0.0.0.0 only if other PCs must reach Node directly on PORT.
HOST=127.0.0.1
PORT=5000

# ---------- Database ----------
# Local MongoDB Community Server, bound to 127.0.0.1 only.
DB_LOCAL_URI=mongodb://127.0.0.1:27017/adlcompany

# ---------- CORS ----------
# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=https://adlcompany.web.app,http://localhost:3000

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_TIME=7d
COOKIE_EXPIRES_TIME=7

# ---------- File storage ----------
# "local" stores uploads on disk and serves them at /uploads; "cloudinary" keeps the old behaviour.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=D:/ADLData/uploads
MAX_UPLOAD_MB=10

# Only required when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=ADL Company
SMTP_FROM_EMAIL=

# ---------- One-off scripts (leave empty in normal operation) ----------
# utils/exportCollections.js
EXPORT_SOURCE_URI=
# config/changeDB.js (clears destination collections before copying)
MIGRATE_SOURCE_URI=
MIGRATE_DEST_URI=
